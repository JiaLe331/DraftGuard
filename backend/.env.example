APP_ENV=development
# Imported mailbox database and immutable attachments; relative to backend/.
LOCAL_DATA_DIR=.local
# Local upload, dataset inbox, and SQLite audit history. Disabled unless explicitly enabled.
ENABLE_DEV_EXTRACTION=false
# Optional absolute paths; defaults locate the sibling participant bundle and backend/.local.
DATASET_DIR=
DEV_AUDIT_DB=
# JSON array of permitted browser origins for a separately hosted frontend.
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional server-side scan extraction. Both values are required to enable it.
# Never put this key in a frontend VITE_ variable or commit it.
GEMINI_API_KEY=
GEMINI_MODEL=
# One provider request is made per scanned PDF; SDK retries are disabled.
GEMINI_TIMEOUT_SECONDS=30

# Reserved for later cloud integrations.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
DEMO_SESSION_SECRET=
