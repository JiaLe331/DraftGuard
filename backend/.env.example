APP_ENV=development
# Development-only SQLite database and immutable source snapshots.
# Relative paths are resolved from backend/. This directory is ignored by Git.
LOCAL_DATA_DIR=.local
# JSON array of permitted frontend origins for CORS and reanalysis requests.
# Add the actual origin if using an alternate frontend port.
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Reserved for future cloud integrations. Leave empty for local dataset analysis.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
GEMINI_API_KEY=
GEMINI_MODEL=
DEMO_SESSION_SECRET=
